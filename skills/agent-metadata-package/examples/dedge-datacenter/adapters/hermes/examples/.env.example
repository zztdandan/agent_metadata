# Copy to .env locally. Do not commit real values.
# Main model / auxiliary providers used by the project-local profile.
RC_CODEX_API_KEY=
RC_DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY=
RCODE_OPENAI_API_KEY=

# Grafana / MCP.
# Runtime source of truth for URL: {agentmemory.grafana.url}
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=
MCP_GRAFANA_API_KEY=

# Optional explicit override for the project external datasource memory file.
# Default design path:而
# /home/base/repo/dedge/dedge-datacenter-harness/dedge-datacenter/runtime/agent-memory/tsdb-memory.json
# This file is the only place allowed to hardcode external system URLs/auth locations.
DEDGE_AGENT_MEMORY_PATH=
DEDGE_TSDB_MEMORY_PATH=
