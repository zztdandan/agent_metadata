{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "schemaVersion",
    "capabilityId",
    "skills",
    "mcp",
    "workspaceAssets",
    "environment"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "const": "agent-capability"
    },
    "schemaVersion": {
      "const": "0.2"
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "mcp": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "workspaceAssets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
